---
/* coPaint homepage — about, features, guides, FAQ, contact and privacy. */
import SiteLayout from '../layouts/SiteLayout.astro';
import Nav from '../components/homepage/Nav.astro';
import Hero from '../components/homepage/Hero.astro';
import Features from '../components/homepage/Features.astro';
import Guides from '../components/homepage/Guides.astro';
import Faq from '../components/homepage/Faq.astro';
import About from '../components/homepage/About.astro';
import Contact from '../components/homepage/Contact.astro';
import Privacy from '../components/homepage/Privacy.astro';
import Footer from '../components/homepage/Footer.astro';
import '../styles/homepage.css';
---
<SiteLayout title="coPaint — About">
  <div id="homePage">
    <div class="hpInner">
      <Nav />
      <Hero />
      <Features />
      <Guides />
      <Faq />
      <About />
      <Contact />
      <Privacy />
      <Footer />
    </div>
  </div>
</SiteLayout>
