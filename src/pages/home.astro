---
/* coPaint homepage — about, features, guides, FAQ, contact and privacy. */
import SiteLayout from '../layouts/SiteLayout.astro';
import Nav from '../components/homepage/Nav.astro';
import Hero from '../components/homepage/Hero.astro';
import Features from '../components/homepage/Features.astro';
import Guides from '../components/homepage/Guides.astro';
import Faq from '../components/homepage/Faq.astro';
import About from '../components/homepage/About.astro';
import Contact from '../components/homepage/Contact.astro';
import Privacy from '../components/homepage/Privacy.astro';
import Footer from '../components/homepage/Footer.astro';
import '../styles/homepage.css';
---
<SiteLayout
  title="coPaint — Free Online Whiteboard, MS Paint Alternative & Collaborative Drawing"
  description="Discover coPaint: a free online whiteboard and drawing app for classrooms, kids, and teams. Enjoy 14 drawing tools, 11 brushes, shapes, stickers, and live collaborative rooms without accounts."
  keywords="online whiteboard, free online whiteboard for teaching, digital whiteboard, collaborative paint online, ms paint online free, whiteboard app, draw together online whiteboard, free paint tool online, online paint app"
  canonical="/home"
>
  <div id="homePage">
    <div class="hpInner">
      <Nav />
      <Hero />
      <Features />
      <Guides />
      <Faq />
      <About />
      <Contact />
      <Privacy />
      <Footer />
    </div>
  </div>
</SiteLayout>
