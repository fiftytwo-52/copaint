  shapeKind = saved.shapeKind || shapeKind; stickerId = saved.stickerId || stickerId;
  stickerMode = saved.stickerMode || stickerMode; outlineId = saved.outlineId || outlineId;
  if (saved.emojiChar) emojiChar = saved.emojiChar;
  brushType = saved.brushType || brushType;
  if (saved.textFont && FONTS.some(f => f.stack === saved.textFont)) textFont = saved.textFont;
  if (saved.view) view = saved.view;
  if (saved.zoom) zoom = Math.max(0.25, Math.min(4, saved.zoom));
}

