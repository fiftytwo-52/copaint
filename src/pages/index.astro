function hidePops() { allPops.forEach(p => p.hidden = true); }
function togglePop(pop, btn) {
  const wasHidden = pop.hidden;
  hidePops();
  if (wasHidden) {
    buildPops();
    pop.hidden = false;
    if (btn) { // anchor the popover next to its button
      const r = btn.getBoundingClientRect();
      const w = pop.offsetWidth, h = pop.offsetHeight;
      if (window.innerWidth <= 760 && btn.id !== 'paperBtn') { // phone left rail: open right of the button
        pop.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, Math.round(r.right + 8))) + 'px';
        pop.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, Math.round(r.top - 4))) + 'px';
      } else if (btn.id === 'paperBtn') { // top-right button: open below-left so it stays on screen
        pop.style.left = Math.max(8, Math.round(r.left - w - 8)) + 'px';
        pop.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, Math.round(r.bottom + 8))) + 'px';
      } else {
        pop.style.left = Math.round(r.right + 8) + 'px';
        pop.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, Math.round(r.top - 4))) + 'px';
      }
    }
  }
}

