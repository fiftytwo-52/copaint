<script>
(() => {
"use strict";
/* =====================================================================
   Kids Paint — single-file paint engine.
   Everything drawn is stored as JSON-serializable items in `items`,
   which makes it ready for a future collaboration/sync layer:
   a sync adapter only needs to broadcast `items` diffs and call
   `applyRemoteItems()`. See SYNC HOOKS below.
   ===================================================================== */

const canvas = document.getElementById('board');
const ctx = canvas.getContext('2d');
const stage = document.getElementById('stage');
const toolbar = document.getElementById('toolbar');
const collapseBtn = document.getElementById('toolCollapse');

let dpr = 1, W = 0, H = 0;

/* ---------------- state ---------------- */
let tool = 'pencil';          // select | pan | pencil | brush | highlighter | eraser | bucket | line | arrow | shape | sticker | text | image
let color = '#1f2937';         // line / stroke color
let size = 8;                 // brush diameter in css px
let dash = 'solid';           // solid | dashed | dotted  (stroke style)
let fillShapes = true;
let fillColor = '#ffd93d';
let fillStyle = 'solid';      // solid | hatch | dots
let shapeKind = 'circle';     // circle | rect | triangle | star | heart
let stickerId = 'star';
