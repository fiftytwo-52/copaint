/* =====================================================================
   CLASSROOM COLLABORATION (SYNC HOOK: realized)
   Zero-setup realtime via a public MQTT broker over WebSocket.
   Same file is teacher (create room) or student (join with code).
   ===================================================================== */
const MQTT_BROKERS = ['wss://broker.emqx.io:8084/mqtt', 'wss://broker.hivemq.com:8884/mqtt', 'wss://test.mosquitto.org:8081/mqtt'];
const ROOM_NS = 'kp1/room/';
const CODE_ABC = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';

function mqttConnect(clientId, onMessage, onState) {
  const enc = new TextEncoder(), dec = new TextDecoder();
  let ws = null, brokerIdx = 0, shouldRun = true, alive = false, pktId = 1;
  let lastRx = 0, pingTimer = null, retryTimer = null, connTimer = null;
  const subs = new Set();
  const encStr = (s) => { const b = enc.encode(s); const o = new Uint8Array(2 + b.length); o[0] = b.length >> 8; o[1] = b.length & 255; o.set(b, 2); return o; };
  const encLen = (n) => { const o = []; do { let d = n % 128; n = Math.floor(n / 128); if (n > 0) d |= 0x80; o.push(d); } while (n > 0); return o; };
  const pkt = (fixed, parts) => {
    const body = []; for (const p of parts) for (let i = 0; i < p.length; i++) body.push(p[i]);
    const head = [fixed, ...encLen(body.length)];
    const out = new Uint8Array(head.length + body.length);
    out.set(head, 0); out.set(body, head.length); return out;
  };
  function setAlive(v) { if (alive !== v) { alive = v; clearTimeout(connTimer); onState(v, { attempt: brokerIdx + 1, total: MQTT_BROKERS.length }); } }
  function scheduleRetry() {
    if (!shouldRun) return;
    setAlive(false);
    clearTimeout(retryTimer);
    retryTimer = setTimeout(() => { brokerIdx = (brokerIdx + 1) % MQTT_BROKERS.length; open(); }, 2500);
  }
  function open() {
    if (!shouldRun) return;
    onState(false, { attempt: brokerIdx + 1, total: MQTT_BROKERS.length });
    try { ws = new WebSocket(MQTT_BROKERS[brokerIdx], 'mqtt'); } catch (e) { scheduleRetry(); return; }
    ws.binaryType = 'arraybuffer';
    clearTimeout(connTimer);
    connTimer = setTimeout(() => { // broker accepted TCP but never answered — move on
      if (!alive && ws && ws.readyState !== 3) { try { ws.close(); } catch (e) {} scheduleRetry(); }
    }, 7000);
    let rest = new Uint8Array(0);
    ws.onopen = () => {
      const vh = new Uint8Array([0, 4, 77, 81, 84, 84, 4, 2, 0, 30]); // MQTT 3.1.1, clean session, keepalive 30s
      ws.send(pkt(0x10, [vh, encStr(clientId)]));
    };
    ws.onmessage = (ev) => {
      lastRx = Date.now();
      const incoming = new Uint8Array(ev.data);
      const buf = new Uint8Array(rest.length + incoming.length);
      buf.set(rest, 0); buf.set(incoming, rest.length); rest = new Uint8Array(0);
      let i = 0;
      while (i < buf.length) {
        const cmd = buf[i] >> 4;
        let mul = 1, len = 0, j = i + 1, b = 0;
        do { if (j >= buf.length) { rest = buf.slice(i); return; } b = buf[j++]; len += (b & 127) * mul; mul *= 128; } while (b & 128);
        if (j + len > buf.length) { rest = buf.slice(i); return; }
        const pl = buf.slice(j, j + len); i = j + len;
        if (cmd === 2) { // CONNACK
          if (pl[1] === 0) { setAlive(true); subs.forEach(t => rawSub(t)); }
          else scheduleRetry();
        } else if (cmd === 3) { // PUBLISH qos0
          const tl = (pl[0] << 8) | pl[1];
          const topic = dec.decode(pl.slice(2, 2 + tl));
          try { onMessage(topic, JSON.parse(dec.decode(pl.slice(2 + tl)))); } catch (e) { /* ignore bad payloads */ }
        }
        // 9 = SUBACK, 13 = PINGRESP: nothing needed
      }
    };
    ws.onerror = () => { try { ws.close(); } catch (e) {} };
    ws.onclose = () => { if (shouldRun) scheduleRetry(); else setAlive(false); };
    clearInterval(pingTimer);
    pingTimer = setInterval(() => {
      if (!shouldRun) return;
      if (alive && ws && ws.readyState === 1) {
        ws.send(new Uint8Array([0xC0, 0x00])); // PINGREQ
        if (Date.now() - lastRx > 45000) { try { ws.close(); } catch (e) {} scheduleRetry(); }
      }
    }, 20000);
  }
  function rawSub(topic) {
    const id = pktId = (pktId % 60000) + 1;
    ws.send(pkt(0x82, [new Uint8Array([id >> 8, id & 255]), encStr(topic), new Uint8Array([0])]));
  }
  open();
  return {
    sub(topic) { subs.add(topic); if (alive && ws && ws.readyState === 1) rawSub(topic); },
    pub(topic, obj) {
      if (!alive || !ws || ws.readyState !== 1) return false;
      try { ws.send(pkt(0x30, [encStr(topic), enc.encode(JSON.stringify(obj))])); return true; }
      catch (e) { return false; }
    },
    close() { shouldRun = false; clearInterval(pingTimer); clearTimeout(retryTimer); clearTimeout(connTimer); try { ws && ws.close(); } catch (e) {} setAlive(false); },
  };
}

/* full-canvas raster (paper + items), used for previews / send-all / pdf */
function renderFullURL(maxW, quality) {
  const k = Math.min(1, maxW / Math.max(1, W));
  const c = document.createElement('canvas');
  c.width = Math.max(1, Math.round(W * k)); c.height = Math.max(1, Math.round(H * k));
  const g = c.getContext('2d');
  g.fillStyle = bg; g.fillRect(0, 0, c.width, c.height);
  g.scale(k, k);
  paintPaper(g, 0, 0, W, H);
  for (const it of items) drawItem(g, it);
  if (pendingShape) drawItem(g, pendingShape);
  if (pendingText) drawItem(g, pendingText);
  return c.toDataURL('image/jpeg', quality);
}
const renderPreviewURL = () => renderFullURL(320, 0.55);

/* ---------------- collab state ---------------- */
const collab = {
  mode: null, // 'teacher' | 'student' | null
  code: '', pass: '', sid: '', name: '', teacherName: '',
  mqtt: null, timers: [],
  students: new Map(), // teacher-side: sid -> {sid,name,img,w,h,lastSeen}
  friends: [], // student-side roster (excluding self)
  teacherLast: 0,
  pdfBuf: [],
  sendAllBackup: null, sendAllItem: null,
  bigSid: null, // student currently enlarged (teacher)
  drawMode: false,
  friendWatch: null, // student-side friend viewer state
  openMode: false, // open canvas: everyone draws on the creator's canvas
  myBackup: null, // collaborator's own items stashed while in open mode
  paused: false, // collaborator-side: creator paused my drawing
  opSeq: 0, applyingRemote: false,
};
const later = (fn, ms) => { const t = setTimeout(fn, ms); collab.timers.push(t); return t; };
const every = (fn, ms) => { const t = setInterval(fn, ms); collab.timers.push(t); return t; };
const roomTopic = (sub) => ROOM_NS + collab.code + '/' + sub;
const myName = () => (nameInput.value.trim() || (collab.mode === 'teacher' ? 'Creator' : 'Collaborator'));
/* ---- open canvas mode: everyone draws together on the creator's canvas ---- */
function myPid() { return collab.mode === 'teacher' ? 't:' + collab.code : (collab.sid || 'x'); }
function nameColor(pid) { let h = 0; const s = String(pid); for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return 'hsl(' + h + ',72%,44%)'; }
/* broadcast a newly committed local item to the shared canvas */
function syncAdd(it) {
  if (!collab.openMode || !collab.mqtt || !collab.connected || collab.applyingRemote || !it) return;
  if (!it.id) it.id = myPid() + ':' + (++collab.opSeq);
  it.owner = myPid(); it.ownerName = myName();
  try { collab.mqtt.pub(roomTopic('all'), { k: 'op', sid: myPid(), name: myName(), item: it }); } catch (e) {}
}
/* broadcast removal of one of my shared items (undo / delete) */
function syncDel(id) {
  if (!collab.openMode || !collab.mqtt || !collab.connected || !id) return;
  try { collab.mqtt.pub(roomTopic('all'), { k: 'del', sid: myPid(), id }); } catch (e) {}
}
/* undo on the shared canvas removes only your own most recent stroke, everywhere */
function undoShared() {
  for (let i = items.length - 1; i >= 0; i--) {
    const it = items[i];
    if (it.sharedBase) continue;
    if (it.owner === myPid()) {
      items.splice(i, 1);
      if (selected === it) selected = null;
      if (pendingOutline === it) pendingOutline = null;
      if (pendingSticker === it) pendingSticker = null;
      syncDel(it.id);
      redraw(); saveState();
      return;
    }
  }
  toast('Nothing of yours to undo');
}
function onAllMsg(m) {
  if (!m || !m.k || !collab.mode || m.sid === myPid()) return; // skip own echo
  if (m.k === 'op') {
    if (!collab.openMode || !m.item || typeof m.item !== 'object') return;
    const it = m.item; it.owner = m.sid; it.ownerName = m.name;
    collab.applyingRemote = true;
    try { items.push(it); } finally { collab.applyingRemote = false; }
    redoStack.length = 0; redraw(); saveState();
  } else if (m.k === 'del') {
    if (!collab.openMode || !m.id) return;
    const i = items.findIndex((it) => it.id === m.id && it.owner === m.sid);
    if (i >= 0) { const rm = items.splice(i, 1)[0]; if (selected === rm) selected = null; redraw(); saveState(); }
  } else if (m.k === 'cursor') {
    if (collab.openMode) showRemoteCursor(m);
  } else if (m.k === 'canvas-req') {
    if (collab.mode === 'teacher' && collab.openMode && m.sid && collab.mqtt) {
      try { collab.mqtt.pub(roomTopic('d/' + m.sid), { k: 'canvas-img', img: renderFullURL(1400, 0.85), w: Math.round(W), h: Math.round(H) }); } catch (e) {}
    }
  } else if (m.k === 'clear') {
    if (!collab.openMode) return;
    items = []; selected = null; redoStack.length = 0;
    redraw(); saveState(); toast('The creator cleared the shared canvas');
  }
}
