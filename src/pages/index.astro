function onTeacherMsg(topic, m) {
  if (!m || !m.k || collab.mode !== 'teacher') return;
  if (m.k === 'join') {
    const nm = String(m.name || 'Collaborator').slice(0, 30);
    if (collab.pass && m.pass !== collab.pass) { collab.mqtt.pub(roomTopic('d/' + m.sid), { k: 'denied' }); return; }
    collab.students.set(m.sid, { sid: m.sid, name: nm, img: null, w: 0, h: 0, lastSeen: Date.now(), seq: 0 });
    collab.mqtt.pub(roomTopic('d/' + m.sid), { k: 'ok', teacher: collab.teacherName, open: !!collab.openMode });
    refreshTeacherPanel(); helloPub();
    tLog('<b>' + escHtml(nm) + '</b> joined the room'); toast(nm + ' joined');
  } else if (m.k === 'leave') {
    const s = collab.students.get(m.sid);
    if (s) { collab.students.delete(m.sid); refreshTeacherPanel(); tLog('<b>' + escHtml(s.name) + '</b> left'); }
  } else if (m.k === 'preview') {
    const s = collab.students.get(m.sid); if (!s || !m.img) return;
    s.img = m.img; s.w = +m.w || 0; s.h = +m.h || 0; s.lastSeen = Date.now(); s.seq++;
