  const ov = document.getElementById('cbDrawLayer'); if (!ov) return;
  const btn = document.getElementById('cbDrawBtn'); if (btn) btn.classList.toggle('on', v);
  ov.hidden = !v;
  if (v) { const r = ov.getBoundingClientRect(); ov.width = Math.max(1, Math.round(r.width)); ov.height = Math.max(1, Math.round(r.height)); }
