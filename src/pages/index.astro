---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = "coPaint";
---
<SiteLayout title={title}>
  <style is:global>
    :root {
      --accent: #ff6b9d;
      --accent-soft: #ffe3ee;
      --ink: #2b2b3a;
      --bar: #ffffff;
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body { height: 100%; margin: 0; overscroll-behavior: none; }
    body {
      font-family: "Baloo 2", "Comic Sans MS", "Chalkboard SE", "Segoe UI Rounded", system-ui, sans-serif;
      color: var(--ink);
      display: flex; flex-direction: row;
      background: #f4f1ff;
      overflow: hidden;
      user-select: none;
      position: relative;
    }
    /* ---------- left toolbar (floating) ---------- */
    #toolbar {
      position: absolute; left: 12px; top: 12px;
      max-height: calc(100% - 24px);
      display: flex; flex-direction: column; align-items: stretch; gap: 2px;
      width: 116px;
      padding: 10px 8px;
      background: #fff;
      border: 1px solid #eceaf3;
      border-radius: 18px;
      box-shadow: 0 4px 16px rgba(30, 30, 50, .08);
      z-index: 20;
      overflow-y: auto; /* shrink-wraps when sections fold; scrolls if content exceeds max-height */
      scrollbar-width: thin;
      scrollbar-gutter: stable both; /* reserve scrollbar space so the grid never overflows horizontally */
    }
    /* expand / collapse */
    #toolCollapse { align-self: center; width: 42px; }
    #toolCollapse .ic-paint { display: none; }
    #toolbar.collapsed .ic-collapse { display: none; }
    #toolbar.collapsed .ic-paint { display: block; }
    #toolbar.collapsed { bottom: auto; width: auto; padding: 6px; border-radius: 16px; }
    #toolbar.collapsed .group { display: none; }
    .group {
      display: grid; grid-template-columns: 1fr 1fr; gap: 6px;
      padding: 8px 2px; border-radius: 0; background: transparent;
      justify-items: center; align-items: center;
    }
    .group + .group { border-top: 1px solid #f0eef6; }
    .group.tools { background: transparent; padding: 8px 2px; gap: 6px; }
    .group-label {
      font-size: 9px; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #b3aec9;
    }
    /* collapsible sections */
    .group-toggle {
      grid-column: 1 / -1; width: 100%;
      display: flex; align-items: center; justify-content: center; gap: 4px;
      background: none; border: none; cursor: pointer; padding: 2px; font: inherit;
    }
    .group-toggle:hover .group-label { color: var(--ink); }
    .group-toggle .foldchev { width: 8px; height: 8px; flex-shrink: 0; transition: transform .15s; }
    .group-toggle:hover .foldchev path { fill: #2b2b3a; }
    .group.folded .foldchev { transform: rotate(180deg); }
    .group.folded > :not(.group-toggle) { display: none !important; } /* !important: beats #sizeRow's ID display:grid */
    .group .wide { grid-column: 1 / -1; width: 100%; }
    #clear { background: #fff; }
    #clear:hover { background: #fef2f2; border-color: #e5c0c0; transform: none; }
    button.tool, button.act {
      width: 40px; height: 40px;
      border: 1.5px solid #e7e4f0; border-radius: 12px;
      background: #fff; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: border-color .1s, background .1s;
      box-shadow: none;
      padding: 0; flex-shrink: 0;
    }
    button.tool { padding: 4px; } /* breathing room around the tool icons */
    button.tool:hover, button.act:hover { border-color: #2b2b3a; background: #f7f7fa; }
    button.tool.active {
      border-color: #2b2b3a; background: #eef0f4;
    }
    button.act:active { transform: scale(.96); }
    button.tool svg, button.act svg, .popover button svg {
      width: 24px; height: 24px; display: block; flex-shrink: 0;
    }
    #sizeRow { grid-column: 1 / -1; display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; gap: 6px; align-items: center; justify-content: center; width: 100%; }
    #sizePlus { grid-column: 1; grid-row: 1; }
    #sizeMinus { grid-column: 1; grid-row: 2; }
    #sizeRow #size { grid-column: 2; grid-row: 1 / 3; }
    #size {
      width: 26px; height: 100px;
      writing-mode: vertical-lr; direction: rtl; appearance: slider-vertical;
      accent-color: var(--accent); cursor: pointer;
    }
    #sizeRow .step {
      width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0;
      font-size: 19px; font-weight: 800; line-height: 1; color: #2b2b3a;
      display: flex; align-items: center; justify-content: center; padding: 0;
    }
    /* the one color dot — tap it to open the full color picker */
    #colorDot {
      grid-column: 1 / -1; justify-self: center;
      width: 42px; height: 42px; border-radius: 50%;
      border: 3px solid #fff; outline: 2px solid rgba(0,0,0,.12);
      cursor: pointer; padding: 0; position: relative;
      box-shadow: 0 1px 3px rgba(0,0,0,.15);
      transition: transform .08s;
    }
    #colorDot:hover { transform: scale(1.1); }
    /* ---------- popovers ---------- */
    .popover {
      position: absolute; left: 144px; top: 12px; z-index: 30;
      background: #fff; border-radius: 18px; padding: 10px;
      box-shadow: 0 8px 30px rgba(80, 60, 140, .25);
      display: grid; gap: 6px;
    }
    #shapePop { grid-template-columns: repeat(3, 1fr); }
    #brushPop { grid-template-columns: repeat(3, 1fr); }
    /* dropdown badges on brush / shapes / text buttons: dark dot with a white chevron */
    button.tool[data-tool="brush"], #shapeBtn, #textBtn { position: relative; }
    button.tool[data-tool="brush"]::after, #shapeBtn::after, #textBtn::after {
      content: ''; position: absolute; right: 1px; bottom: 1px; pointer-events: none;
      width: 8px; height: 8px; border-radius: 50%;
      background: #2b2b3a url('data:image/svg+xml;utf8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Cpath d=%22M6 9l6 6 6-6%22 fill=%22none%22 stroke=%22white%22 stroke-width=%225%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E') center / 5px 5px no-repeat;
      border: 1px solid #fff;
      box-shadow: 0 1px 2px rgba(0,0,0,.25);
    }
    #stickerPop { max-width: 252px; }
    #fontPop { grid-template-columns: 1fr; min-width: 168px; }
    #fontPop button { justify-content: flex-start; height: auto; padding: 8px 12px; }
    #strokePop, #fillStylePop { grid-template-columns: 1fr; }
    #exportPop { grid-template-columns: 1fr; min-width: 170px; }
    #bgPop { grid-template-columns: repeat(4, 1fr); }
    #bgPop .popSecLabel {
      grid-column: 1 / -1; font-size: 10px; font-weight: 800; text-transform: uppercase;
      letter-spacing: .06em; color: #8b86a8; margin-top: 6px; text-align: left;
    }
    #bgPop .popSecLabel:first-child { margin-top: 0; }
    #bgPop .popSecGrid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    /* color picker popover: swatches + custom + opacity */
    #colorPop { grid-template-columns: repeat(4, 1fr); }
    #colorPop .sw {
      width: 30px; height: 30px; min-width: 0; border-radius: 50%; justify-self: center;
      border: 3px solid #fff; outline: 2px solid rgba(0,0,0,.12);
      cursor: pointer; padding: 0;
      box-shadow: 0 1px 3px rgba(0,0,0,.15);
    }
    #colorPop .sw:hover { transform: scale(1.12); }
    #colorPop .sw.active { outline: 3px solid var(--accent); }
    #colorPop .sw.rainbow { background: conic-gradient(#ef4444,#facc15,#22c55e,#3b82f6,#8b5cf6,#ef4444); }
    #colorPop .opwrap {
      grid-column: 1 / -1; display: flex; align-items: center; gap: 6px;
      padding-top: 4px;
    }
    #colorPop .opwrap span { font-size: 11px; font-weight: 700; color: #8888a0; white-space: nowrap; }
    #colorPop .opwrap input[type="range"] { flex: 1; accent-color: var(--accent); cursor: pointer; }
    #colorPop .opval { font-size: 11px; font-weight: 700; color: #55556a; min-width: 34px; text-align: right; }
    /* blue save-picture button floating at the canvas top-right */
    #saveImgBtn {
      position: absolute; top: 10px; right: 174px; z-index: 15;
      width: 44px; height: 44px; border-radius: 12px; border: 2px solid #bcdcff;
      background: #fff; cursor: pointer; padding: 6px;
      box-shadow: 0 2px 8px rgba(47,123,255,.25); transition: transform .08s;
    }
    #saveImgBtn:hover { transform: scale(1.08); }
    #saveImgBtn svg { width: 100%; height: 100%; display: block; }
    /* paper color/pattern button floating at the canvas top-right, left of save */
    #paperBtn {
      position: absolute; top: 10px; right: 228px; z-index: 15;
      width: 44px; height: 44px; border-radius: 12px; border: 2px solid #e3dcff;
      background: #fff; cursor: pointer; padding: 6px;
      box-shadow: 0 2px 8px rgba(80,60,140,.18); transition: transform .08s;
    }
    #paperBtn:hover { transform: scale(1.08); }
    #paperBtn svg { width: 100%; height: 100%; display: block; }
    /* A4 print-area toggle, bottom-right of the canvas */
    #a4Btn {
      position: absolute; bottom: 12px; right: 12px; z-index: 15;
      width: 44px; height: 44px; border-radius: 12px; border: 2px solid #e3dcff;
      background: #fff; cursor: pointer; padding: 6px;
      box-shadow: 0 2px 8px rgba(80,60,140,.18); transition: transform .08s;
    }
    #a4Btn:hover { transform: scale(1.08); }
    #a4Btn svg { width: 100%; height: 100%; display: block; }
    #a4Btn.on { border-color: var(--accent); background: #eef4ff; }
    /* info button floating just above the A4 button */
    #infoBtn {
      position: absolute; bottom: 66px; right: 12px; z-index: 15;
      width: 44px; height: 44px; border-radius: 12px; border: 2px solid #e3dcff;
      background: #fff; cursor: pointer; padding: 6px;
      box-shadow: 0 2px 8px rgba(80,60,140,.18); transition: transform .08s;
      display: block; box-sizing: border-box;
    }
    #infoBtn:hover { transform: scale(1.08); }
    #infoBtn svg { width: 100%; height: 100%; display: block; }
    /* clear-all confirmation popover */
    #clearPop { padding: 12px; min-width: 210px; }
    #clearPop[hidden] { display: none; }
    #clearPop .clearTitle { font-weight: 800; color: #2b2b3a; font-size: 14px; text-align: center; margin-bottom: 10px; }
    #clearPop .clearRow { display: flex; gap: 8px; }
    #clearPop .clearRow button {
      flex: 1; padding: 10px 8px; border-radius: 10px; font-weight: 800; font-size: 13px;
      cursor: pointer; font-family: inherit;
    }
    #clearNo { background: #fff; color: #2b2b3a; border: 2px solid #e3dcff; }
    #clearYes { background: #ffe9e9; color: #c0392b; border: 2px solid #f5b7b1; }
    /* floating shape-tools bar that follows the selected shape */
    #shapeFillBar {
      position: absolute; z-index: 25; display: flex; flex-direction: column; align-items: stretch; gap: 6px;
      background: #fff; border-radius: 14px; padding: 8px 10px;
      box-shadow: 0 4px 16px rgba(80,60,140,.25);
    }
    #shapeFillBar[hidden] { display: none; }
    .sbar-row { display: flex; align-items: center; gap: 6px; }
    .sbar-label {
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
      color: #8b86a8; min-width: 46px; flex-shrink: 0;
    }
    #shapeOutlineColors { display: flex; gap: 5px; align-items: center; }
    #shapeFillBar button.mini.stepbtn { font-size: 18px; font-weight: 800; color: #2b2b3a; }
    #outlineSize { width: 84px; accent-color: var(--accent); cursor: pointer; }
    .fdot {
      width: 24px; height: 24px; border-radius: 50%; border: 2px solid #fff;
      outline: 2px solid rgba(0,0,0,.12); cursor: pointer; padding: 0;
    }
    .fdot:hover { transform: scale(1.15); }
    .fdot.active { outline: 3px solid var(--accent); }
    #shapeFillBar button.mini {
      width: 34px; height: 34px; border-radius: 10px; border: 2px solid #e3dcff;
      background: #fff; cursor: pointer; padding: 3px;
    }
    #shapeFillBar button.mini svg { width: 100%; height: 100%; display: block; }
    #shapeFillBar button.mini.off { filter: grayscale(1); opacity: .45; }
    #shapeFillBar button.mini.rainbow {
      border-radius: 50%; padding: 0;
      background: conic-gradient(#ef4444,#facc15,#22c55e,#3b82f6,#8b5cf6,#ef4444);
    }
    #shapeFillNoFill.active { outline: 3px solid #2b2b3a; background: #eef0f4; }
    /* sticker popover tabs */
    .popTabs { display: flex; gap: 6px; margin-bottom: 2px; grid-column: 1 / -1; }
    .popTabs button {
      flex: 1; border: 2px solid #e3dcff; background: #fff; border-radius: 10px;
      padding: 6px 8px; font: 700 13px inherit; color: #6a6580; cursor: pointer;
    }
    .popTabs button.on { background: var(--accent); border-color: var(--accent); color: #fff; }
    .popGrid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
      grid-column: 1 / -1; max-height: 300px; overflow-y: auto; padding-right: 2px;
    }
    .popGrid button img { width: 40px; height: 40px; object-fit: contain; display: block; pointer-events: none; }
    .popGrid button.emojiBtn { font-size: 30px; line-height: 1; padding: 4px; }
    #stickerBtn img { width: 26px; height: 26px; object-fit: contain; display: block; }
    .popover[hidden] { display: none; }

    /* ---------------- classroom collaboration ---------------- */
    #collabUI { position: fixed; inset: 0; pointer-events: none; z-index: 40; }
    #collabUI > * { pointer-events: auto; }
    #collabPop { min-width: 230px; max-width: 260px; }
    .cpTitle { font-weight: 800; font-size: 15px; color: #2b2b3a; text-align: center; }
    .cpSub { font-size: 12px; color: #6b6884; text-align: center; margin-top: -2px; }
    .cpJoinBtn {
      width: 100%; padding: 12px; font-size: 16px; font-weight: 800; color: #fff;
      background: #2f7bff; border: none; border-radius: 14px; cursor: pointer;
      box-shadow: 0 3px 10px rgba(47,123,255,.4);
    }
    .cpJoinBtn:active { transform: scale(.97); }
    .cpCreateRow { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 2px; }
    .cpCreateRow span { font-size: 11px; color: #8b86a8; }
    #cpCreateBtn {
      width: 100%; padding: 10px; margin-top: 8px; font-size: 14px; font-weight: 800;
      background: #efecf9; color: #57536e; border: none; border-radius: 14px; cursor: pointer;
    }
    #cpCreateBtn:hover { background: #e2ddf3; }
    #cpCreateBtn:active { transform: scale(.97); }
    .cpField { display: grid; gap: 4px; }
    .cpField label { font-size: 12px; font-weight: 700; color: #57536e; }
    .cpField input {
      padding: 9px 10px; font-size: 15px; border: 2px solid #d9d5ec; border-radius: 10px;
      font-family: inherit; color: #2b2b3a; background: #fbfaff;
    }
    .cpField input:focus { outline: none; border-color: #2f7bff; }
    .cpRow { display: flex; gap: 8px; }
    .cpRow button { flex: 1; padding: 10px; border-radius: 12px; font-weight: 800; font-size: 14px; cursor: pointer; border: none; }
    .cpPrimary { background: #2f7bff; color: #fff; }
    .cpGhost { background: #efecf9; color: #57536e; }
    .cpCode {
      font-size: 34px; font-weight: 900; letter-spacing: 8px; text-align: center; color: #2b2b3a;
      background: #f4f2fb; border: 2px dashed #b9b4d6; border-radius: 14px; padding: 10px 6px 10px 14px;
      cursor: pointer; user-select: all;
    }
    .cpHint { font-size: 11.5px; color: #8b86a8; text-align: center; }
    .cpErr { font-size: 12.5px; color: #d33; text-align: center; font-weight: 700; min-height: 16px; }

    #remoteCursors {
      position: absolute; inset: 0; pointer-events: none; z-index: 12; overflow: hidden;
    }
    .rcursor {
      position: absolute; transform: translate(-4px, -4px); display: none;
      pointer-events: none; white-space: nowrap;
    }
    .rcursor .rcdot {
      display: inline-block; width: 12px; height: 12px; border-radius: 50%;
      border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,.35);
      vertical-align: middle;
    }
    .rcursor.drawing .rcdot { width: 16px; height: 16px; }
    .rcursor .rcname {
      display: inline-block; margin-left: 5px; padding: 2px 8px; border-radius: 10px;
      background: rgba(43,43,58,.85); color: #fff; font-size: 11px; font-weight: 700;
      vertical-align: middle;
    }
    /* open-canvas mode: creator toggle + collaborator chips */
    .tpModeRow { display: flex; gap: 6px; margin-top: 8px; }
    .tpMode {
      flex: 1; padding: 8px 4px; border-radius: 12px; border: 2px solid #e3dcff;
      background: #f7f5ff; color: #57536e; font-weight: 800; font-size: 12px; cursor: pointer;
    }
    .tpMode.on { background: #2f7bff; border-color: #2f7bff; color: #fff; }
    #tOpenList { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 12px; overflow-y: auto; }
    .tChip {
      display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px 5px 6px;
      background: #f4f2fb; border-radius: 20px; font-size: 12px; font-weight: 700; color: #2b2b3a;
    }
    .tChip .tDot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }

    /* teacher side panel */
    #tPanel {
      position: fixed; left: 124px; top: 12px; bottom: 12px; width: 248px; z-index: 45;
      background: #fff; border-radius: 18px; box-shadow: 0 8px 30px rgba(80,60,140,.25);
      display: flex; flex-direction: column; overflow: hidden;
    }
    #tPanel .tpHead { padding: 10px 12px 8px; border-bottom: 2px solid #f0edf9; }
    #tPanel .tpCodeRow { display: flex; align-items: center; gap: 6px; }
    #tPanel .tpCode {
      font-size: 22px; font-weight: 900; letter-spacing: 4px; color: #2b2b3a; cursor: pointer;
    }
    #tPanel .tpCount { font-size: 12px; color: #6b6884; font-weight: 700; }
    #tPanel .tpBtns { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 8px; }
    #tPanel .tpBtns button {
      padding: 8px 4px; border-radius: 10px; border: none; font-size: 12px; font-weight: 800; cursor: pointer;
    }
    #tpSend { background: #2f7bff; color: #fff; grid-column: 1 / -1; }
    #tpPdf { background: #e8f5e9; color: #1b7a3d; }
    #tpLogBtn { background: #efecf9; color: #57536e; }
    #tpEnd { background: #fdecec; color: #c62828; grid-column: 1 / -1; }
    #tCards { flex: 1; overflow-y: auto; padding: 8px; display: grid; gap: 8px; align-content: start; }
    .tCard {
      border: 2px solid #e6e1f5; border-radius: 12px; overflow: hidden; cursor: pointer; background: #fbfaff;
    }
    .tCard:hover { border-color: #2f7bff; }
    .tCard img { width: 100%; aspect-ratio: 4/3; object-fit: contain; background: #fff; display: block; }
    .tCard .tCardName {
      display: flex; align-items: center; gap: 6px; padding: 5px 8px; font-size: 13px; font-weight: 800; color: #2b2b3a;
    }
    .tDot { width: 9px; height: 9px; border-radius: 50%; background: #22c55e; flex: none; }
    .tDot.off { background: #c9c5dd; }
    .tCardName .tNm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tCardBtns { display: flex; gap: 4px; margin-left: auto; }
    .tPauseBtn, .tKickBtn {
      width: 28px; height: 28px; border-radius: 8px; border: 2px solid #e6e1f5; background: #fff;
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 2px; flex: none;
    }
    .tPauseBtn:hover, .tKickBtn:hover { border-color: #2f7bff; }
    .tPauseBtn svg, .tKickBtn svg { width: 18px; height: 18px; display: block; }
    .tCard.paused { border-color: #f5d98b; }
    .tCard.paused img { opacity: .55; filter: grayscale(.4); }
    .tChip.paused { background: #fdf6e3; }
    .tChip .tMini {
      width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid #e0dbf2; background: #fff;
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 2px; flex: none;
    }
    .tChip .tMini:hover { border-color: #2f7bff; }
    .tChip .tMini svg { width: 14px; height: 14px; display: block; }
    #tLog { border-top: 2px solid #f0edf9; max-height: 150px; overflow-y: auto; padding: 8px 10px; font-size: 12px; color: #57536e; }
    #tLog div { padding: 2px 0; border-bottom: 1px dotted #eeeaf9; }
    #tLog .lt { color: #a09bc0; margin-right: 6px; }

    /* enlarged student modal (teacher) + friend viewer (student) */
    .cbModal {
      position: fixed; inset: 0; z-index: 60; background: rgba(30,25,60,.45);
      display: flex; align-items: center; justify-content: center; pointer-events: auto;
    }
    .cbModal[hidden] { display: none; }
    .cbBox {
      background: #fff; border-radius: 20px; padding: 14px; max-width: min(860px, 92vw); max-height: 88vh;
      display: flex; flex-direction: column; gap: 8px; box-shadow: 0 20px 60px rgba(40,30,90,.4);
    }
    .cbBoxHead { display: flex; align-items: center; gap: 8px; }
    .cbBoxHead .cbName { font-size: 17px; font-weight: 900; color: #2b2b3a; flex: 1; }
    .cbBoxHead button {
      border: none; border-radius: 10px; padding: 8px 12px; font-weight: 800; font-size: 13px; cursor: pointer;
    }
    .cbClose { background: #efecf9; color: #57536e; }
    .cbDraw { background: #fff3d6; color: #8a6d1a; }
    .cbDraw.on { background: #ffd166; color: #5b430a; }
    .cbStage { position: relative; line-height: 0; }
    .cbStage img { max-width: min(820px, 88vw); max-height: 62vh; border-radius: 12px; border: 2px solid #e6e1f5; background: #fff; }
    #cbDrawLayer { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; border-radius: 12px; }
    .cbNote { font-size: 12px; color: #8b86a8; }

    /* student room bar */
    #sBar {
      position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 45;
      display: flex; align-items: center; gap: 8px; background: #fff; border-radius: 999px;
