let view = { x: 0, y: 0 };    // canvas pan offset, css px
let zoom = 1;                 // canvas zoom (0.25 - 4)
let areaSel = null;           // area-select rectangle, world coords {x0,y0,x1,y1,w,h}
let areaDrag = null;          // in-progress area drag
let items = [];               // committed drawing items (serializable)
let redoStack = [];
let drawing = null;           // in-progress freehand stroke
let preview = null;           // in-progress shape/line preview
let selected = null;          // selected item (select tool)
let drag = null;              // active drag: pan | move

const LS_KEY = 'kids-paint-v1';
function loadState() {
  try { return JSON.parse(localStorage.getItem(LS_KEY)); } catch { return null; }
}
function saveState() {
  try {
    localStorage.setItem(LS_KEY, JSON.stringify({
      v: 3, bg, bgPattern, showA4, color, size, opacity, dash, fillColor, fillStyle, fillShapes,
      shapeKind, stickerId, stickerMode, outlineId, emojiChar, brushType, textFont, view, zoom,
      toolbarCollapsed: toolbar.classList.contains('collapsed'),
      toolbarPos,
      foldedGroups: [...document.querySelectorAll('#toolbar .group.folded')].map(g => g.dataset.gid),
      name: document.getElementById('nameInput').value,
      items,
    }));
  } catch { /* storage full / private mode — drawing still works */ }
}
const saved = loadState();
if (saved) {
  items = Array.isArray(saved.items) ? saved.items : [];
  bg = saved.bg || bg; color = saved.color || color; size = saved.size || size;
  if (saved.bgPattern) bgPattern = saved.bgPattern;
  showA4 = !!saved.showA4;
