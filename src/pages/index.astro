const BRUSH_NAMES = { round: 'Round', marker: 'Marker', calligraphy: 'Calligraphy', spray: 'Spray', crayon: 'Crayon', neon: 'Neon', dots: 'Dots', rainbow: 'Rainbow', taper: 'Taper', sketch: 'Sketch', chalk: 'Chalk' };
const BRUSH_ICONS = {
