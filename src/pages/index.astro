    if (m.img) { collab.pdfBuf.push({ sid: m.sid, name: String(m.name || 'Collaborator').slice(0, 40), img: m.img }); tLog('Received ' + escHtml(m.name || 'Collaborator') + "'s page (" + collab.pdfBuf.length + ')'); }
