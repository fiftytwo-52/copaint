/* ---------------- floating selection toolbar ---------------- */
const selBar = document.getElementById('selBar');
function updateSelBar() {
  if (tool !== 'select' || !selected) { selBar.hidden = true; return; }
  const b = rotAABB(selected);
  if (!b) { selBar.hidden = true; return; }
  selBar.hidden = false;
  const x = Math.max(8, Math.min(Math.max(8, W - 210), b.x0 * zoom + view.x));
  selBar.style.left = x + 'px';
  selBar.style.top = Math.max(8, b.y0 * zoom + view.y - 54) + 'px';
