function showRemoteCursor(m) {
  const layer = document.getElementById('remoteCursors'); if (!layer) return;
  const id = 'rc-' + String(m.sid).replace(/[^a-z0-9]/gi, '');
  let d = document.getElementById(id);
  if (!d) {
    d = document.createElement('div'); d.id = id; d.className = 'rcursor';
    d.innerHTML = '<span class="rcdot"></span><span class="rcname"></span>';
    layer.appendChild(d);
  }
  d.querySelector('.rcdot').style.background = nameColor(m.sid);
  d.querySelector('.rcname').textContent = String(m.name || 'Collaborator').slice(0, 20);
  d.style.left = (Math.max(0, Math.min(1, +m.fx || 0)) * 100) + '%';
  d.style.top = (Math.max(0, Math.min(1, +m.fy || 0)) * 100) + '%';
