let emojiChar = '😀';        // active emoji when stickerMode === 'emoji'
let stickerTab = 'fun';       // fun | color | emoji — sticker popover tab
let outlineId = 'cat';
let brushType = 'round';        // current brush variety for the brush tool
let opacity = 1;                // 0.1 - 1 drawing opacity
let pendingShape = null;        // shape drawn but not yet fixed (editable until you click outside)
let pendingText = null;         // text placed but not yet fixed (editable until you click outside)
let pendingOutline = null;      // coloring outline placed but not yet fixed (draggable until you click outside)
let pendingSticker = null;      // vector sticker placed but not yet fixed (resizable/rotatable until you click outside)
let editingText = null;         // text item currently open in the text editor
const FONTS = [
  { id: 'round', name: 'Rounded', stack: '"Baloo 2","Comic Sans MS","Chalkboard SE","Segoe UI Rounded",sans-serif' },
  { id: 'hand', name: 'Handwriting', stack: '"Segoe Print","Bradley Hand","Comic Sans MS","Chalkboard SE",cursive' },
  { id: 'block', name: 'Bold', stack: '"Arial Black","Archivo Black",Impact,"Segoe UI",sans-serif' },
  { id: 'classic', name: 'Classic', stack: 'Georgia,"Times New Roman",serif' },
  { id: 'type', name: 'Typewriter', stack: '"Courier New",Courier,monospace' },
];
let textFont = FONTS[0].stack;  // active font for new text
let bg = '#ffffff';
let bgPattern = 'plain'; // plain | ruled | graph | dots | numbered — paper pattern drawn over bg
let showA4 = false;       // A4 print-area guide overlay (bottom-right toggle)
let toolbarPos = null;    // user-dragged floating toolbar position {x, y}
