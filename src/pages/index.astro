function clearDrawOverlay() {
  const ov = document.getElementById('cbDrawLayer');
  if (ov && !ov.hidden) ov.getContext('2d').clearRect(0, 0, ov.width, ov.height);
}
function setupDrawOverlay() {
  const ov = document.getElementById('cbDrawLayer');
  let pts = null;
  const toStudent = (e) => {
    const s = collab.students.get(collab.bigSid); if (!s || !s.w || !s.h) return null;
    const r = ov.getBoundingClientRect();
    return { x: (e.clientX - r.left) / r.width * s.w, y: (e.clientY - r.top) / r.height * s.h };
  };
  ov.addEventListener('pointerdown', (e) => {
    const p = toStudent(e); if (!p) return;
    e.preventDefault(); try { ov.setPointerCapture(e.pointerId); } catch {}
    pts = [p];
    const s = collab.students.get(collab.bigSid);
    const g = ov.getContext('2d');
    g.strokeStyle = color; g.lineCap = 'round'; g.lineJoin = 'round';
    g.lineWidth = Math.max(1.5, size * (ov.width / s.w));
    g.globalAlpha = opacity;
    g.beginPath(); g.moveTo(p.x / s.w * ov.width, p.y / s.h * ov.height);
  });
  ov.addEventListener('pointermove', (e) => {
    if (!pts) return;
    const p = toStudent(e); if (!p) return;
    pts.push(p);
    const s = collab.students.get(collab.bigSid);
    const g = ov.getContext('2d');
    g.lineTo(p.x / s.w * ov.width, p.y / s.h * ov.height); g.stroke();
  });
  const up = () => {
    if (!pts || pts.length < 1) { pts = null; return; }
    collab.mqtt.pub(roomTopic('d/' + collab.bigSid), {
      k: 'op', by: collab.teacherName,
      stroke: { color, size, dash, alpha: opacity, points: pts },
    });
    pts = null;
  };
  ov.addEventListener('pointerup', up);
  ov.addEventListener('pointercancel', () => { pts = null; });
}
function teacherSendAll() {
  if (!collab.students.size) { toast('No collaborators joined yet'); return; }
  const url = renderFullURL(1400, 0.85);
  collab.mqtt.pub(roomTopic('t'), { k: 'send-all', img: url, w: Math.round(W), h: Math.round(H), by: collab.teacherName });
