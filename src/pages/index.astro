      }
      if (stampSrc) {
        // drag a box like the shape tool — the stamp scales freely to fit it
        preview = { type: 'image', src: stampSrc, ax: p.x, ay: p.y, x: p.x, y: p.y, w: 0, h: 0, alpha: 1 };
      }
    } else {
      if (pendingSticker) {
        if (hitTest(p) === pendingSticker) {
          // drag the just-placed sticker to move it; clicking elsewhere fixes it and stamps a new one
          drag = { mode: 'move', lx: p.x, ly: p.y, moved: false };
          selected = pendingSticker;
          redraw();
          return;
        }
        pendingSticker = null; // fixed in place — fall through and stamp a fresh one
        selected = null;
      }
      const st = { type: 'sticker', id: stickerId, x: p.x, y: p.y, s: size, alpha: opacity };
      items.push(st);
      pendingSticker = st; selected = st; // stays resizable/rotatable until you click elsewhere
      redoStack.length = 0;
      redraw(); saveState();
      syncAdd(st);
    }
    return;
  }
  if (tool === 'bucket') { bucketFill(p); return; }
  if (tool === 'text') {
    if (pendingText) {
      const b = itemBounds(pendingText);
      if (p.x >= b.x0 - 6 && p.x <= b.x1 + 6 && p.y >= b.y0 - 6 && p.y <= b.y1 + 6) {
        // tap the pending text to re-edit it, drag it to move it
        drag = { mode: 'move', lx: p.x, ly: p.y, moved: false, pendingText: true };
        selected = pendingText;
        redraw();
        return;
      }
      fixPendingText(false);
    } else {
      const hit = hitTest(p);
      if (hit && hit.type === 'text') {
        // drag the text box to move it; a tap without dragging opens the editor
        drag = { mode: 'move', lx: p.x, ly: p.y, moved: false, editText: hit };
        selected = hit;
        redraw();
        return;
      }
    }
    openTextEditor(p);
    return;
  }
  if (tool === 'image') { document.getElementById('imagePicker').click(); setTool('select'); return; }
  if (tool === 'shape') {
    if (pendingShape) {
      const rh0 = hitResizeHandle(e);
      if (rh0 === 'rot') { beginResize(rh0, p); return; } // rotate the pending shape
      const lp = toLocal(pendingShape, p);
      const b = itemBounds(pendingShape);
      if (lp.x >= b.x0 - 6 && lp.x <= b.x1 + 6 && lp.y >= b.y0 - 6 && lp.y <= b.y1 + 6) {
        // drag the pending shape to adjust its place before fixing it
        drag = { mode: 'move', lx: p.x, ly: p.y, moved: false, pending: true };
        selected = pendingShape;
      } else {
        commitPending(false); // clicking the outer area fixes its place and size
      }
      redraw();
      return;
    }
    preview = {
      type: 'shape', kind: shapeKind, x0: p.x, y0: p.y, x1: p.x, y1: p.y,
      color, size, dash, fill: fillShapes, fillColor, fillStyle, alpha: opacity,
    };
    return;
  }
  if (tool === 'line' || tool === 'arrow') {
    const kind = tool;
    preview = {
      type: 'shape', kind, x0: p.x, y0: p.y, x1: p.x, y1: p.y,
      color, size, dash, fill: fillShapes, fillColor, fillStyle, alpha: opacity,
    };
    return;
  }
  drawing = {
    type: 'stroke', tool, color, dash,
    brush: tool === 'brush' ? brushType : undefined,
    size: tool === 'eraser' ? Math.max(size * 2.5, 14)
         : tool === 'highlighter' ? Math.max(size * 3, 18) : size,
    points: [p], alpha: opacity,
  };
  redraw();
});

function hoverTarget() { // the pending/selected item the pointer can grab and move right now
  if (tool === 'shape' && pendingShape) return pendingShape;
  if (tool === 'sticker' && pendingOutline) return pendingOutline;
  if (tool === 'sticker' && pendingSticker) return pendingSticker;
  if (tool === 'text' && pendingText) return pendingText;
  if (tool === 'select' && selected) return selected;
  return null;
}
canvas.addEventListener('pointerleave', () => {
  if (eraserHover) { eraserHover = null; redraw(); }
  canvas.style.cursor = CURSORS[tool] || 'crosshair';
});
canvas.addEventListener('pointermove', (e) => {
  const p = pos(e);
  if (tool === 'eraser') { // track the pointer so the dotted size circle follows it
    const r = canvas.getBoundingClientRect();
    const nx = e.clientX - r.left, ny = e.clientY - r.top;
    if (!eraserHover || Math.abs(eraserHover.x - nx) > 0.5 || Math.abs(eraserHover.y - ny) > 0.5) {
      eraserHover = { x: nx, y: ny };
      if (!drawing) redraw();
    }
    canvas.style.cursor = 'none';
  } else if (eraserHover) {
    eraserHover = null;
    redraw();
  }
  if (!drag && !areaDrag && !drawing && !preview && (tool === 'select' || tool === 'text' || tool === 'shape' || tool === 'sticker')) {
    const rh = hitResizeHandle(e);
    let cur = '';
    if (rh) cur = rh === 'rot' ? 'grab' : ((rh === 'nw' || rh === 'se') ? 'nwse-resize' : 'nesw-resize');
    else {
      const hov = hoverTarget();
      if (hov && hitTest(p) === hov) cur = 'move'; // hovering the item body: it can be dragged
      else if (tool === 'text') cur = 'text';
    }
    canvas.style.cursor = cur;
  }
  if (drag && drag.mode === 'rotate' && selected) {
    const a = Math.atan2(p.y - drag.cy, p.x - drag.cx);
    let rot = Math.atan2(Math.sin(drag.r0 + a - drag.a0), Math.cos(drag.r0 + a - drag.a0));
    const step = Math.PI / 12, sn = Math.round(rot / step) * step; // gentle 15° snap
    if (Math.abs(rot - sn) < 0.09) rot = sn;
    selected.rot = rot;
    drag.moved = true;
    redraw();
    return;
  }
  if (drag && drag.mode === 'resize' && selected) {
    const lp = toLocal(selected, p); // resize in the item's unrotated frame
    if (selected.type === 'image') {
      const h = drag.handle, minS = 24;
      let x0, y0, x1, y1;
      if (h[1] === 'w') { x0 = lp.x; x1 = drag.ax; } else { x0 = drag.ax; x1 = lp.x; }
      if (h[0] === 'n') { y0 = lp.y; y1 = drag.ay; } else { y0 = drag.ay; y1 = lp.y; }
      if (x1 - x0 < minS) { if (h[1] === 'w') x0 = x1 - minS; else x1 = x0 + minS; }
      if (y1 - y0 < minS) { if (h[0] === 'n') y0 = y1 - minS; else y1 = y0 + minS; }
      selected.x = x0; selected.y = y0;
      selected.w = x1 - x0; selected.h = y1 - y0;
    } else if (selected.type === 'text') { // text: uniform scale of the font size, anchored at the center
      const d = Math.max(8, Math.hypot(lp.x - drag.cx, lp.y - drag.cy));
      selected.s = Math.max(4, Math.min(200, drag.s0 * d / drag.d0));
      const b2 = itemBounds(selected);
      if (b2) {
        selected.x += drag.cx - (b2.x0 + b2.x1) / 2;
        selected.y += drag.cy - (b2.y0 + b2.y1) / 2;
      }
    } else {
      const d = Math.max(8, Math.hypot(lp.x - drag.cx, lp.y - drag.cy));
      selected.s = Math.max(8, Math.min(600, drag.s0 * d / drag.d0));
    }
    drag.moved = true;
    redraw();
    return;
  }
  if (drag && drag.mode === 'pan') {
    view.x += e.clientX - drag.sx;
    view.y += e.clientY - drag.sy;
    drag.sx = e.clientX; drag.sy = e.clientY;
    clampView();
    redraw();
    return;
  }
  if (drag && drag.mode === 'move' && selected) {
    const dx = p.x - drag.lx, dy = p.y - drag.ly;
    if (dx || dy) {
      shiftItem(selected, dx, dy);
      drag.lx = p.x; drag.ly = p.y; drag.moved = true;
      redraw();
    }
    return;
  }
  if (areaDrag) {
    areaSel = {
      x0: Math.min(areaDrag.x0, p.x), y0: Math.min(areaDrag.y0, p.y),
      x1: Math.max(areaDrag.x0, p.x), y1: Math.max(areaDrag.y0, p.y),
    };
    areaSel.w = areaSel.x1 - areaSel.x0;
    areaSel.h = areaSel.y1 - areaSel.y0;
    redraw();
    return;
  }
  if (drawing) {
    const pts = drawing.points, last = pts[pts.length - 1];
    if (Math.hypot(p.x - last.x, p.y - last.y) < 2) return;
    pts.push(p);
    redraw();
  } else if (preview) {
    if (preview.type === 'image') { // coloring outline: drag-to-place box
      preview.x = Math.min(preview.ax, p.x);
      preview.y = Math.min(preview.ay, p.y);
      preview.w = Math.abs(p.x - preview.ax);
      preview.h = Math.abs(p.y - preview.ay);
    } else {
      preview.x1 = p.x; preview.y1 = p.y;
    }
    redraw();
  }
});

function endPointer() {
  if (drag && drag.mode === 'pan') { canvas.style.cursor = 'grab'; saveState(); }
  if (drag && drag.mode === 'move' && !drag.moved && (drag.pendingText || drag.editText)) {
    const t = drag.pendingText ? pendingText : drag.editText;
    drag = null;
    if (t) openTextEditor(null, t); // tap without dragging re-edits the text
  }
  else if (drag && (drag.mode === 'move' || drag.mode === 'resize' || drag.mode === 'rotate') && drag.moved && !drag.pending) { redoStack.length = 0; saveState(); }
  drag = null;
  if (areaDrag) {
    areaDrag = null;
    if (!areaSel || areaSel.w < 8 || areaSel.h < 8) areaSel = null;
    redraw();
  }
  if (drawing) { const d = drawing; drawing = null; commit(d); }
  else if (preview) {
    const pv = preview; preview = null;
    if (pv.type === 'image') { // coloring outline drag-to-place
      let placed;
      if (pv.w > 8 && pv.h > 8) placed = pv; // placed at the dragged size
      else { // simple tap — stamp at the default size
        const w = Math.max(48, size * 7);
        placed = { type: 'image', src: pv.src, x: pv.ax - w / 2, y: pv.ay - w / 2, w, h: w, alpha: 1 };
      }
      items.push(placed);
      pendingOutline = placed; selected = placed; // stays movable until you click elsewhere
      redoStack.length = 0;
      redraw(); saveState();
      syncAdd(placed);
    } else if (Math.hypot(pv.x1 - pv.x0, pv.y1 - pv.y0) > 4) {
      if (pv.kind === 'line' || pv.kind === 'arrow') commit(pv);
      else { pendingShape = pv; selected = pv; } // stays editable until you click outside
    }
    redraw();
  }
}
canvas.addEventListener('pointerup', endPointer);
canvas.addEventListener('pointercancel', endPointer);
canvas.addEventListener('contextmenu', (e) => e.preventDefault());
/* double-click a text item with the select tool to re-edit its words */
canvas.addEventListener('dblclick', (e) => {
  if (tool !== 'select' || !textEditWrap.hidden) return;
  const hit = hitTest(pos(e));
  if (hit && hit.type === 'text') {
    if (hit !== pendingText) fixPendingText(false);
    selected = hit;
    openTextEditor(null, hit);
  }
});

/* mouse wheel pans the canvas */
stage.addEventListener('wheel', (e) => {
  e.preventDefault();
  view.x -= e.deltaX; view.y -= e.deltaY;
  clampView(); redraw();
}, { passive: false });

/* zoom */
const zoomInput = document.getElementById('zoomInput');
function refreshZoomLabel() { zoomInput.value = Math.round(zoom * 100) + '%'; }
function applyZoomInput() { // typed zoom %, clamped to 25–400
  const n = parseInt(zoomInput.value.replace(/[^0-9]/g, ''), 10);
  if (isNaN(n)) { refreshZoomLabel(); return; }
  setZoom(Math.max(25, Math.min(400, n)) / 100);
}
zoomInput.addEventListener('focus', () => zoomInput.select());
zoomInput.addEventListener('keydown', (e) => {
  e.stopPropagation(); // keep tool shortcuts / Delete out of the zoom field
  if (e.key === 'Enter') { applyZoomInput(); zoomInput.blur(); }
  else if (e.key === 'Escape') { refreshZoomLabel(); zoomInput.blur(); }
});
zoomInput.addEventListener('change', applyZoomInput);
zoomInput.addEventListener('dblclick', () => setZoom(1));
function setZoom(nz, cx, cy) {
  nz = Math.max(0.25, Math.min(4, nz));
  if (cx === undefined) cx = W / 2;
  if (cy === undefined) cy = H / 2;
  const wx = (cx - view.x) / zoom, wy = (cy - view.y) / zoom;
  zoom = nz;
  view.x = cx - wx * zoom; view.y = cy - wy * zoom;
  clampView();
  refreshZoomLabel();
  redraw(); saveState();
}
document.getElementById('zoomIn').onclick = () => setZoom(zoom + 0.02);
document.getElementById('zoomOut').onclick = () => setZoom(zoom - 0.02);

/* ---------------- text tool ---------------- */
const textEdit = document.getElementById('textEdit');
const textEditWrap = document.getElementById('textEditWrap');
const textEditGrip = document.getElementById('textEditGrip');
let textAnchor = null;
function openTextEditor(p, item) {
  editingText = item || null;
  textAnchor = item ? null : p;
  textEditWrap.hidden = false;
  textEdit.value = item ? item.text : '';
  const fx = item ? item.x : p.x, fy = item ? item.y : p.y;
  textEditWrap.style.left = Math.min(fx * zoom + view.x, W - 200) + 'px';
  textEditWrap.style.top = Math.min(fy * zoom + view.y, H - 48) + 'px';
  textEdit.style.fontSize = Math.max(16, Math.min(40, (item ? item.s : size) * 2)) + 'px';
  textEdit.style.fontFamily = item ? (item.font || FONT_STACK) : textFont;
  setTimeout(() => { textEdit.focus(); textEdit.select(); }, 0);
}
function closeTextEditor(commitIt = true) {
  if (textEditWrap.hidden) return;
  const t = textEdit.value.trim();
  const p = textAnchor;
  const item = editingText;
  textEditWrap.hidden = true;
  textAnchor = null;
  editingText = null;
  if (!commitIt || !t) { redraw(); return; }
  if (item) {
    item.text = t;                  // re-editing an existing text item
    redraw(); saveState();
    return;
  }
  if (p) {
    pendingText = { type: 'text', text: t, x: p.x, y: p.y, s: size, color, alpha: opacity, font: textFont };
    selected = pendingText;         // stays editable until you click outside
    redraw(); saveState();
  }
}
textEdit.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') closeTextEditor(true);
  else if (e.key === 'Escape') closeTextEditor(false);
  e.stopPropagation();
});
textEdit.addEventListener('blur', () => closeTextEditor(true));
/* drag the text box around by its grip strip so it never covers the drawing */
let gripDrag = null;
textEditGrip.addEventListener('pointerdown', (e) => {
  e.preventDefault(); e.stopPropagation();
  const r = textEditWrap.getBoundingClientRect();
  gripDrag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
  textEditGrip.setPointerCapture(e.pointerId);
});
textEditGrip.addEventListener('pointermove', (e) => {
  if (!gripDrag) return;
  const parent = textEditWrap.offsetParent.getBoundingClientRect();
  textEditWrap.style.left = Math.max(0, Math.min(parent.width - 60, e.clientX - parent.left - gripDrag.dx)) + 'px';
  textEditWrap.style.top = Math.max(0, Math.min(parent.height - 40, e.clientY - parent.top - gripDrag.dy)) + 'px';
});
const endGrip = () => { gripDrag = null; };
textEditGrip.addEventListener('pointerup', endGrip);
textEditGrip.addEventListener('pointercancel', endGrip);

/* ---------------- image insert ---------------- */
const imagePicker = document.getElementById('imagePicker');
imagePicker.addEventListener('change', () => {
  const file = imagePicker.files && imagePicker.files[0];
  imagePicker.value = '';
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    const img = new Image();
    img.onload = () => {
      const maxDim = 720;
      const k = Math.min(1, maxDim / Math.max(img.naturalWidth, img.naturalHeight));
      const w = Math.round(img.naturalWidth * k), h = Math.round(img.naturalHeight * k);
      const t = document.createElement('canvas');
      t.width = w; t.height = h;
      t.getContext('2d').drawImage(img, 0, 0, w, h);
      const src = t.toDataURL('image/jpeg', 0.85);
      const it = {
        type: 'image', src,
        x: (-view.x + W / 2) / zoom - w / 2, y: (-view.y + H / 2) / zoom - h / 2,
        w, h,
      };
      commit(it);
      setTool('select');
      selected = it;
      redraw();
      toast('Picture added — drag it to move');
    };
    img.src = reader.result;
  };
  reader.readAsDataURL(file);
});

/* ---------------- toast ---------------- */
const toastEl = document.getElementById('toast');
let toastTimer = null;
function toast(msg) {
  toastEl.textContent = msg;
  toastEl.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toastEl.classList.remove('show'), 1600);
}

