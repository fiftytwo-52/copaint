}
function collabConnProgress(info) {
  // show "Connecting… (1/3)" in the visible create/join popup while brokers are tried
  if (!info || info.attempt == null) return;
  const errEl = document.querySelector('#collabPop:not([hidden]) .cpErr');
  if (errEl && /^(Starting room|Joining|Connecting)/.test(errEl.textContent)) {
    errEl.textContent = 'Connecting… (' + info.attempt + '/' + info.total + ')';
  }
}
function createRoom(pass, cb) {
  if (collab.mode) { cb(false, 'Already in a room.'); return; }
  let done = false;
  const finish = (ok, msg) => { if (!done) { done = true; cb(ok, msg); } };
  Object.assign(collab, { mode: 'teacher', code: genCode(), pass: pass || '', teacherName: myName(), connected: false, _tBeat: false });
  collab.students = new Map();
  const cid = 'kp-t-' + collab.code + '-' + Math.random().toString(36).slice(2, 8);
  collab.mqtt = mqttConnect(cid,
    (topic, m) => {
      if (collab.mode !== 'teacher') return;
      if (/\/all$/.test(topic)) onAllMsg(m);
      else if (/\/s$/.test(topic)) onTeacherMsg(topic, m);
    },
    (up, info) => {
      collab.connected = up;
      if (!up && info) collabConnProgress(info);
      if (up && !collab._connAt) collab._connAt = Date.now();
      if (up && collab.mode === 'teacher') {
        collab.mqtt.sub(roomTopic('s'));
        collab.mqtt.sub(roomTopic('all'));
        if (!document.getElementById('tPanel')) {
          buildTeacherUI();
          tLog('Room <b>' + escHtml(collab.code) + '</b> created' + (collab.pass ? ' (password set)' : ' (open room)'));
          toast('Room ' + collab.code + ' — share the code with collaborators');
        }
        if (!collab._tBeat) { collab._tBeat = true; every(helloPub, 3000); every(pruneStudents, 5000); }
        helloPub();
        finish(true);
      } else if (!up && collab.mode === 'teacher' && document.getElementById('tPanel')) {
        toast('Connection lost — retrying…');
      }
    });
  later(() => { if (collab.mode === 'teacher' && !collab.connected) { teardownCollab(); finish(false, 'Could not reach the network — check internet and retry.'); } }, 30000);
}
function endRoom() {
  try { if (collab.mqtt) collab.mqtt.pub(roomTopic('t'), { k: 'end' }); } catch (e) {}
  teardownCollab('Room ended');
}

/* ---- classroom PDF: one A4 page per student, labeled with name ---- */
function b64ToBytes(b64) { const bin = atob(b64); const o = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) o[i] = bin.charCodeAt(i); return o; }
function makePdf(jpegs) {
  const enc = new TextEncoder();
  const chunks = []; let pos = 0;
  const offsets = [0];
  const emit = (d) => { chunks.push(d); pos += d.length; };
  emit(enc.encode('%PDF-1.4\n'));
  const n = jpegs.length, kids = [], defs = [];
  for (let i = 0; i < n; i++) {
    const pN = 3 + i * 3, cN = 4 + i * 3, imN = 5 + i * 3;
    kids.push(pN + ' 0 R');
    const content = enc.encode('q\n595 0 0 842 0 0 cm\n/Im0 Do\nQ');
    defs.push({ num: pN, parts: [enc.encode('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /XObject << /Im0 ' + imN + ' 0 R >> >> /Contents ' + cN + ' 0 R >>')] });
    defs.push({ num: cN, parts: [enc.encode('<< /Length ' + content.length + ' >>\nstream\n'), content, enc.encode('\nendstream')] });
    const jp = jpegs[i];
    defs.push({ num: imN, parts: [enc.encode('<< /Type /XObject /Subtype /Image /Width ' + jp.w + ' /Height ' + jp.h + ' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ' + jp.bytes.length + ' >>\nstream\n'), jp.bytes, enc.encode('\nendstream')] });
  }
  defs.push({ num: 1, parts: [enc.encode('<< /Type /Catalog /Pages 2 0 R >>')] });
  defs.push({ num: 2, parts: [enc.encode('<< /Type /Pages /Kids [' + kids.join(' ') + '] /Count ' + n + ' >>')] });
  defs.sort((a, b) => a.num - b.num);
  for (const d of defs) {
    offsets[d.num] = pos;
    emit(enc.encode(d.num + ' 0 obj\n'));
    for (const p of d.parts) emit(p);
    emit(enc.encode('\nendobj\n'));
  }
  const xrefPos = pos, total = 2 + n * 3;
  let xref = 'xref\n0 ' + (total + 1) + '\n0000000000 65535 f \n';
  for (let i = 1; i <= total; i++) xref += String(offsets[i]).padStart(10, '0') + ' 00000 n \n';
  xref += 'trailer\n<< /Size ' + (total + 1) + ' /Root 1 0 R >>\nstartxref\n' + xrefPos + '\n%%EOF';
  emit(enc.encode(xref));
  return new Blob(chunks, { type: 'application/pdf' });
}
async function sharedPdf() {
  toast('Making PDF…');
  try {
    const PW = 794, PH = 1123;
    const img = new Image();
    await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = renderFullURL(1400, 0.85); });
    const c = document.createElement('canvas'); c.width = PW; c.height = PH;
    const g = c.getContext('2d');
    g.fillStyle = '#ffffff'; g.fillRect(0, 0, PW, PH);
    g.fillStyle = '#2b2b3a'; g.font = '800 46px "Comic Sans MS","Chalkboard SE","Segoe UI",cursive,sans-serif';
    g.textBaseline = 'top';
    g.fillText('Shared canvas — room ' + collab.code, 48, 44, PW - 96);
    const s = Math.min((PW - 96) / img.naturalWidth, (PH - 190) / img.naturalHeight);
    const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
    const bx = 48, by = 128, bw = PW - 96, bh = PH - 176;
    g.fillStyle = '#ffffff'; g.fillRect(bx, by, bw, bh);
    g.drawImage(img, bx + (bw - dw) / 2, by + (bh - dh) / 2, dw, dh);
    g.strokeStyle = '#d9d5ec'; g.lineWidth = 2; g.strokeRect(bx, by, bw, bh);
    const blob = makePdf([{ w: PW, h: PH, bytes: b64ToBytes(c.toDataURL('image/jpeg', 0.9).split(',')[1]) }]);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'shared-' + collab.code + '.pdf';
    document.body.appendChild(a); a.click(); a.remove();
    toast('Shared canvas saved');
  } catch (e) { toast('Could not build the PDF'); }
}
async function buildClassPdf() {
  const pages = collab.pdfBuf.slice(); collab.pdfBuf = [];
  if (collab.mode !== 'teacher' || !pages.length) { if (collab.mode === 'teacher') toast('No collaborator work received'); return; }
  toast('Making PDF…');
  const PW = 794, PH = 1123, jpegs = [];
  for (const p of pages) {
    try {
      const img = new Image();
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = p.img; });
      const c = document.createElement('canvas'); c.width = PW; c.height = PH;
      const g = c.getContext('2d');
      g.fillStyle = '#ffffff'; g.fillRect(0, 0, PW, PH);
      g.fillStyle = '#2b2b3a'; g.font = '800 46px "Comic Sans MS","Chalkboard SE","Segoe UI",cursive,sans-serif';
      g.textBaseline = 'top';
      const nm = (p.name || 'Collaborator').slice(0, 40);
      g.fillText(nm, 48, 44, PW - 96);
      const s = Math.min((PW - 96) / img.naturalWidth, (PH - 190) / img.naturalHeight);
      const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
      const bx = 48, by = 128, bw = PW - 96, bh = PH - 176;
      g.fillStyle = '#ffffff'; g.fillRect(bx, by, bw, bh);
      g.drawImage(img, bx + (bw - dw) / 2, by + (bh - dh) / 2, dw, dh);
      g.strokeStyle = '#d9d5ec'; g.lineWidth = 2; g.strokeRect(bx, by, bw, bh);
      jpegs.push({ w: PW, h: PH, bytes: b64ToBytes(c.toDataURL('image/jpeg', 0.9).split(',')[1]) });
    } catch (e) { /* skip unreadable page */ }
  }
  if (!jpegs.length) { toast('Could not build the PDF'); return; }
  const blob = makePdf(jpegs);
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'classroom-' + collab.code + '.pdf';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  tLog('Downloaded PDF with ' + jpegs.length + ' pages');
  toast('PDF downloaded — ' + jpegs.length + ' pages');
}
function teacherPdf() {
  if (collab.openMode) { sharedPdf(); return; }
  if (!collab.students.size) { toast('No collaborators joined yet'); return; }
  collab.pdfBuf = [];
  collab.mqtt.pub(roomTopic('t'), { k: 'pdf-req' });
  toast('Collecting collaborator work…');
  later(() => buildClassPdf(), 7000);
}

/* ================= STUDENT ================= */
function buildStudentUI() {
  const ui = document.getElementById('collabUI');
  ui.innerHTML =
    '<div id="sBar"><span class="sCode">' + escHtml(collab.code) + '</span><span id="sTeacher"></span>' +
    '<span id="sPaused" hidden>Paused</span>' +
    '<button id="sFriendsBtn">Friends (0)</button><button id="sLeaveBtn">Leave</button></div>' +
    '<div id="sFriends" hidden></div><div id="tDrawingPill" hidden></div>' +
    '<div class="cbModal" id="cbFriend" hidden><div class="cbBox">' +
      '<div class="cbBoxHead"><span class="cbName" id="cbFriendName"></span>' +
      '<button class="cbClose" id="cbFriendClose">Close</button></div>' +
      '<div class="cbStage"><img id="cbFriendImg" alt=""></div>' +
      '<div class="cbNote">Watching a friend — view only. Close to go back to your work.</div>' +
    '</div></div>';
  document.getElementById('sLeaveBtn').onclick = () => leaveRoom(false);
  document.getElementById('sFriendsBtn').onclick = () => { const f = document.getElementById('sFriends'); f.hidden = !f.hidden; };
  document.getElementById('cbFriendClose').onclick = closeFriend;
  updateTeacherLabel(); renderFriends();
}
function updateTeacherLabel() {
  const t = document.getElementById('sTeacher');
  if (t) t.textContent = collab.teacherName ? 'Creator: ' + collab.teacherName : 'Finding creator…';
}
function updatePausedUI() {
  const p = document.getElementById('sPaused');
  if (p) p.hidden = !collab.paused;
}
function updateFriends(list) {
  collab.friends = (list || []).filter((f) => f.sid !== collab.sid);
  renderFriends();
}
function renderFriends() {
  const btn = document.getElementById('sFriendsBtn'); if (!btn) return;
  btn.textContent = 'Friends (' + collab.friends.length + ')';
  const wrap = document.getElementById('sFriends'); if (!wrap) return;
  wrap.innerHTML = '';
  if (!collab.friends.length) { wrap.innerHTML = '<div class="cpHint">No friends here yet.</div>'; return; }
  const colors = ['#2f7bff', '#8b5cf6', '#ec4899', '#22c55e', '#f97316', '#0ea5e9', '#a16207'];
  collab.friends.forEach((f, i) => {
    const w = document.createElement('div'); w.className = 'fWrap';
    const b = document.createElement('button'); b.className = 'fCircle';
    b.style.background = colors[i % colors.length];
    b.textContent = (String(f.name).trim()[0] || '?').toUpperCase();
    b.title = f.name;
    b.onclick = () => openFriend(f);
    const nm = document.createElement('small'); nm.textContent = f.name;
    w.appendChild(b); w.appendChild(nm); wrap.appendChild(w);
  });
}
function openFriend(f) {
  closeFriend();
  document.getElementById('cbFriendName').textContent = f.name;
  const im = document.getElementById('cbFriendImg'); im.removeAttribute('src');
  document.getElementById('cbFriend').hidden = false;
  const req = () => { if (collab.mode === 'student' && collab.mqtt) collab.mqtt.pub(roomTopic('d/' + f.sid), { k: 'preview-req', from: collab.sid }); };
  req();
  const timer = setInterval(req, 2500);
  collab.timers.push(timer);
  collab.friendWatch = { sid: f.sid, timer };
}
function closeFriend() {
  if (collab.friendWatch) { clearInterval(collab.friendWatch.timer); collab.friendWatch = null; }
  const m = document.getElementById('cbFriend'); if (m) m.hidden = true;
}
function applyForeignStroke(m) {
  const st = m.stroke; if (!st || !Array.isArray(st.points) || !st.points.length) return;
  commit({
    type: 'stroke', tool: 'pencil', color: st.color || '#111111', dash: 'solid',
    size: st.size || 8, alpha: st.alpha == null ? 1 : st.alpha,
    points: st.points.map((p) => ({ x: +p.x || 0, y: +p.y || 0 })),
  });
  const pill = document.getElementById('tDrawingPill');
  if (pill) {
    pill.textContent = (m.by || 'Creator') + ' is drawing…';
    pill.hidden = false;
    clearTimeout(pill._t); pill._t = setTimeout(() => { pill.hidden = true; }, 3000);
  }
}
function applySendAll(m) {
  if (!m.img || !m.w || !m.h) return;
  collab.sendAllBackup = items.slice();
  const s = Math.min(W / m.w, H / m.h);
  const dw = m.w * s, dh = m.h * s;
  const it = { type: 'image', src: m.img, x: (W - dw) / 2, y: (H - dh) / 2, w: dw, h: dh, alpha: 1 };
  collab.sendAllItem = it;
  items.length = 0; redoStack.length = 0;
  items.push(it); selected = null; redraw(); saveState();
  toast('Creator ' + (m.by || '') + ' shared their canvas');
}
/* undo right after a send-all restores the student's own work */
const _undo0 = document.getElementById('undo').onclick;
document.getElementById('undo').onclick = () => {
  if (collab.sendAllItem && items.length === 1 && items[0] === collab.sendAllItem && collab.sendAllBackup) {
    items.length = 0;
    for (const it of collab.sendAllBackup) items.push(it);
    collab.sendAllItem = null; collab.sendAllBackup = null;
    selected = null; redraw(); saveState(); toast('Your work restored');
    return;
  }
  if (collab.openMode) { undoShared(); return; }
  _undo0();
};
function onStudentT(m) {
  if (!m || !m.k || collab.mode !== 'student') return;
  if (m.k === 'hello') {
    collab.teacherLast = Date.now();
    if (m.name && m.name !== collab.teacherName) { collab.teacherName = m.name; updateTeacherLabel(); }
    if (Array.isArray(m.students)) updateFriends(m.students);
    if (m.open && !collab.openMode) enterOpenMode();
    /* NOTE: never exit openMode on hello — a stale heartbeat must not kick
       collaborators out; explicit 'mode' messages are authoritative */
  } else if (m.k === 'send-all') {
    applySendAll(m);
  } else if (m.k === 'end') {
    teardownCollab('Room ended — back to your own canvas');
  } else if (m.k === 'mode') {
    if (m.open) enterOpenMode(); else exitOpenMode();
  } else if (m.k === 'pdf-req') {
    if (collab.connected) collab.mqtt.pub(roomTopic('s'), { k: 'pdf', sid: collab.sid, name: myName(), img: renderFullURL(1400, 0.85), w: Math.round(W), h: Math.round(H) });
  }
}
function onStudentDirect(m) {
  if (!m || !m.k || collab.mode !== 'student') return;
  if (m.k === 'ok') {
    collab.teacherName = m.teacher || 'Creator';
    buildStudentUI();
    if (m.open) enterOpenMode();
    saveRoom({ code: collab.code, pass: collab.pass });
    toast('Joined room ' + collab.code);
    if (collab.joinCb) { const cb = collab.joinCb; collab.joinCb = null; cb(true); }
  } else if (m.k === 'denied') {
    const cb = collab.joinCb; collab.joinCb = null;
    teardownCollab();
    if (cb) cb(false, 'Wrong password.');
  } else if (m.k === 'op') {
    applyForeignStroke(m);
  } else if (m.k === 'canvas-img') {
    if (collab.openMode && m.img && m.w && m.h) {
      const s = Math.min(W / m.w, H / m.h);
      const dw = m.w * s, dh = m.h * s;
      items = [{ type: 'image', src: m.img, x: (W - dw) / 2, y: (H - dh) / 2, w: dw, h: dh, alpha: 1, sharedBase: true }];
      selected = null; redraw(); saveState();
    }
  } else if (m.k === 'preview1') {
    if (collab.friendWatch && m.from === collab.friendWatch.sid) {
      const im = document.getElementById('cbFriendImg'); if (im && m.img) im.src = m.img;
    }
  } else if (m.k === 'preview-req') {
    if (!document.hidden && collab.connected) collab.mqtt.pub(roomTopic('d/' + m.from), { k: 'preview1', from: collab.sid, img: renderPreviewURL() });
  } else if (m.k === 'kick') {
    teardownCollab('You were removed from the room by the creator');
  } else if (m.k === 'pause') {
    collab.paused = !!m.paused;
    updatePausedUI();
    toast(collab.paused ? 'The creator paused drawing for now' : 'The creator let you draw again');
  }
}
function joinRoom(code, pass, cb) {
  if (collab.mode) { cb(false, 'Already in a room.'); return; }
  let done = false;
  const finish = (ok, msg) => { if (!done) { done = true; cb(ok, msg); } };
  collab.joinCb = finish;
  Object.assign(collab, { mode: 'student', code, pass: pass || '', sid: getSid(), name: myName(), teacherLast: 0, teacherName: '', friends: [], connected: false, paused: false, _connAt: 0 });
  const cid = 'kp-s-' + code + '-' + collab.sid;
  collab.mqtt = mqttConnect(cid,
    (topic, m) => {
      if (collab.mode !== 'student') return;
      if (/\/t$/.test(topic)) onStudentT(m);
      else if (/\/all$/.test(topic)) onAllMsg(m);
      else if (topic.endsWith('/d/' + collab.sid)) onStudentDirect(m);
    },
    (up, info) => {
      collab.connected = up;
      if (!up && info) collabConnProgress(info);
      if (up && !collab._connAt) collab._connAt = Date.now();
      if (up && collab.mode === 'student') {
        collab.mqtt.sub(roomTopic('t'));
        collab.mqtt.sub(roomTopic('d/' + collab.sid));
        collab.mqtt.sub(roomTopic('all'));
        collab.mqtt.pub(roomTopic('s'), { k: 'join', sid: collab.sid, name: collab.name, pass: collab.pass });
      } else if (!up && collab.mode === 'student' && document.getElementById('sBar')) {
        toast('Connection lost — retrying…');
      }
    });
  every(() => {
    if (collab.mode !== 'student' || document.hidden || !collab.connected || collab.openMode) return;
    collab.mqtt.pub(roomTopic('s'), { k: 'preview', sid: collab.sid, img: renderPreviewURL(), w: Math.round(W), h: Math.round(H) });
  }, 2500);
  every(() => {
    if (collab.mode !== 'student') return;
    if (collab.teacherLast && Date.now() - collab.teacherLast > 30000) teardownCollab('Room ended — back to your own canvas');
  }, 3000);
  const joinT0 = Date.now();
  every(() => {
    if (collab.mode !== 'student' || document.getElementById('sBar')) return;
    if (collab.connected && collab._connAt && Date.now() - collab._connAt > 12000) {
      teardownCollab(); finish(false, 'Room not found — check the code.');
    } else if (!collab.connected && Date.now() - joinT0 > 30000) {
      teardownCollab(); finish(false, 'Could not reach the network — check internet and retry.');
    }
  }, 1000);
}
function leaveRoom(silent) {
  try { if (collab.mqtt) collab.mqtt.pub(roomTopic('s'), { k: 'leave', sid: collab.sid }); } catch (e) {}
  teardownCollab(silent ? null : 'Left the room');
}
function teardownCollab(msg) {
  collab.timers.forEach((t) => { clearTimeout(t); clearInterval(t); });
  collab.timers = [];
  try { collab.mqtt && collab.mqtt.close(); } catch (e) {}
  if (collab.myBackup) { items = collab.myBackup; selected = null; redraw(); saveState(); }
  Object.assign(collab, { mqtt: null, mode: null, connected: false, _tBeat: false, _connAt: 0, joinCb: null, bigSid: null, drawMode: false, friendWatch: null, sendAllItem: null, sendAllBackup: null, pdfBuf: [], friends: [], teacherLast: 0, teacherName: '', openMode: false, myBackup: null, opSeq: 0, applyingRemote: false, paused: false });
  collab.students = new Map();
  clearRemoteCursors();
  const ui = document.getElementById('collabUI'); if (ui) ui.innerHTML = '';
  if (msg) toast(msg);
}
window.addEventListener('beforeunload', () => {
  if (!collab.mqtt || !collab.mode) return;
  try {
    if (collab.mode === 'teacher') collab.mqtt.pub(roomTopic('t'), { k: 'end' });
    else collab.mqtt.pub(roomTopic('s'), { k: 'leave', sid: collab.sid });
  } catch (e) {}
});
})();
