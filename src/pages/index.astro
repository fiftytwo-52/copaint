/* ---------------- canvas sizing ---------------- */
function resize() {
  const r = stage.getBoundingClientRect();
  dpr = Math.max(1, window.devicePixelRatio || 1);
  W = Math.max(1, r.width); H = Math.max(1, r.height);
  canvas.width = Math.round(W * dpr);
  canvas.height = Math.round(H * dpr);
  redraw();
}
new ResizeObserver(resize).observe(stage);

function clampView() {
  view.x = Math.max(-1600, Math.min(1600, view.x));
  view.y = Math.max(-1600, Math.min(1600, view.y));
}

/* ---------------- drawing primitives ---------------- */
function applyDash(c, width, d) {
  if (d === 'dashed') c.setLineDash([14, 10]);
  else if (d === 'dotted') c.setLineDash([0.1, Math.max(6, width * 1.4)]);
  else c.setLineDash([]);
}

function tracePath(c, pts) {
  c.beginPath();
  if (pts.length === 1) {
    c.arc(pts[0].x, pts[0].y, 0.4, 0, Math.PI * 2);
    c.fill();
    return;
  }
  c.moveTo(pts[0].x, pts[0].y);
  for (let i = 1; i < pts.length - 1; i++) {
    const xc = (pts[i].x + pts[i + 1].x) / 2;
    const yc = (pts[i].y + pts[i + 1].y) / 2;
    c.quadraticCurveTo(pts[i].x, pts[i].y, xc, yc);
  }
  const l = pts[pts.length - 1];
  c.lineTo(l.x, l.y);
}

/* deterministic pseudo-random (stable across redraws) for spray/crayon texture */
function srand(n) { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }

function drawStroke(c, it) {
  const pts = it.points;
  const brush = it.tool === 'brush' ? (it.brush || 'round') : 'round';
  const s = it.size;
  c.save();
  if (it.tool === 'eraser') c.globalCompositeOperation = 'destination-out';
  else if (it.tool === 'highlighter') c.globalAlpha *= 0.35;
  c.strokeStyle = it.color;
  c.fillStyle = it.color;
  if (pts.length === 1) {
    c.beginPath();
    c.arc(pts[0].x, pts[0].y, s / 2, 0, Math.PI * 2);
    c.fill();
    c.restore();
    return;
  }
  const poly = () => tracePath(c, pts);
  switch (brush) {
    case 'marker': // flat chisel tip
      c.lineWidth = s * 1.7; c.lineCap = 'butt'; c.lineJoin = 'miter';
      poly(); c.stroke();
      break;
    case 'calligraphy': { // angled nib
      for (const p of pts) {
        c.save(); c.translate(p.x, p.y); c.rotate(-0.5);
        c.beginPath(); c.ellipse(0, 0, s * 0.5, Math.max(1, s * 0.16), 0, 0, Math.PI * 2); c.fill();
        c.restore();
      }
      break;
    }
    case 'spray': { // airbrush speckles
      const a0 = c.globalAlpha;
      c.globalAlpha = a0 * 0.55;
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        for (let k = 0; k < 12; k++) {
          const a = srand(i * 31 + k * 7) * Math.PI * 2;
          const r = s * srand(i * 17 + k * 13) * 0.9;
          c.beginPath();
          c.arc(p.x + Math.cos(a) * r, p.y + Math.sin(a) * r, Math.max(0.8, s * 0.07), 0, Math.PI * 2);
          c.fill();
        }
      }
      c.globalAlpha = a0;
      break;
    }
    case 'crayon': { // rough triple pass
      const a0 = c.globalAlpha;
      c.globalAlpha = a0 * 0.8;
      c.lineCap = 'round'; c.lineJoin = 'round'; c.lineWidth = s * 0.55;
      for (let pass = -1; pass <= 1; pass++) {
        c.beginPath();
        for (let i = 0; i < pts.length; i++) {
          const p = pts[i];
          const jx = (srand(i * 3 + pass * 101) - 0.5) * s * 0.22;
          const jy = (srand(i * 7 + pass * 57) - 0.5) * s * 0.22;
          if (i === 0) c.moveTo(p.x + jx, p.y + jy); else c.lineTo(p.x + jx, p.y + jy);
        }
        c.stroke();
      }
      c.globalAlpha = a0;
      break;
    }
    case 'neon': { // glow + bright core
      const a0 = c.globalAlpha;
      c.lineCap = 'round'; c.lineJoin = 'round';
      c.shadowColor = it.color; c.shadowBlur = s * 2;
      c.globalAlpha = a0 * 0.9; c.lineWidth = s * 0.9;
      poly(); c.stroke();
      c.shadowBlur = 0;
      c.globalAlpha = Math.min(1, a0 + 0.5); c.strokeStyle = '#ffffff';
      c.lineWidth = Math.max(1.5, s * 0.32);
      poly(); c.stroke();
      break;
    }
    case 'dots': { // dotted trail
      const step = Math.max(s * 0.9, 5);
      const dot = (x, y) => { c.beginPath(); c.arc(x, y, Math.max(1.2, s * 0.3), 0, Math.PI * 2); c.fill(); };
      let acc = 0, px = pts[0].x, py = pts[0].y;
      dot(px, py);
      for (let i = 1; i < pts.length; i++) {
        let dx = pts[i].x - px, dy = pts[i].y - py;
        let d = Math.hypot(dx, dy);
        while (d > 0 && acc + d >= step) {
          const t = (step - acc) / d;
          px += dx * t; py += dy * t;
          dot(px, py);
          dx = pts[i].x - px; dy = pts[i].y - py; d = Math.hypot(dx, dy); acc = 0;
        }
        acc += d; px = pts[i].x; py = pts[i].y;
      }
      break;
    }
    case 'rainbow': { // hue cycles along the stroke
      c.lineCap = 'round'; c.lineJoin = 'round'; c.lineWidth = s;
      for (let i = 1; i < pts.length; i++) {
        c.strokeStyle = 'hsl(' + ((i * 14) % 360) + ', 90%, 55%)';
        c.beginPath();
        c.moveTo(pts[i - 1].x, pts[i - 1].y);
        c.lineTo(pts[i].x, pts[i].y);
        c.stroke();
      }
      break;
    }
    case 'taper': { // thick start, thin end
      c.lineCap = 'round'; c.lineJoin = 'round'; c.strokeStyle = it.color;
      const n = pts.length;
      for (let i = 1; i < n; i++) {
        c.lineWidth = Math.max(1, s * (1 - 0.85 * (i / (n - 1))));
        c.beginPath();
        c.moveTo(pts[i - 1].x, pts[i - 1].y);
        c.lineTo(pts[i].x, pts[i].y);
        c.stroke();
      }
      break;
    }
    case 'sketch': { // loose double pencil line
      const a0 = c.globalAlpha;
      c.globalAlpha = a0 * 0.9;
      c.strokeStyle = it.color; c.lineCap = 'round'; c.lineJoin = 'round';
      c.lineWidth = Math.max(1, s * 0.4);
      for (let pass = 0; pass < 2; pass++) {
        c.beginPath();
        for (let i = 0; i < pts.length; i++) {
          const p = pts[i];
          const jx = (srand(i * 11 + pass * 131) - 0.5) * s * 0.5;
          const jy = (srand(i * 13 + pass * 71) - 0.5) * s * 0.5;
          if (i === 0) c.moveTo(p.x + jx, p.y + jy); else c.lineTo(p.x + jx, p.y + jy);
        }
        c.stroke();
      }
      c.globalAlpha = a0;
      break;
    }
    case 'chalk': { // soft grainy stick
      const a0 = c.globalAlpha;
      c.strokeStyle = it.color; c.lineCap = 'round'; c.lineJoin = 'round';
      c.globalAlpha = a0 * 0.25; c.lineWidth = s;
      poly(); c.stroke();
      c.fillStyle = it.color;
      c.globalAlpha = a0 * 0.8;
