    }
    if (collab.bigSid === m.sid) {
      const bi = document.getElementById('cbBigImg');
      if (bi) { bi.style.display = ''; bi.src = m.img; }
      const note = document.getElementById('cbBigNote');
      if (note) note.textContent = 'Live view — turn on Draw to sketch on ' + s.name + "'s canvas.";
      const db = document.getElementById('cbDrawBtn'); if (db) db.disabled = false;
      clearDrawOverlay();
    }
