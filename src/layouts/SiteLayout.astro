---
/* Shared page shell for coPaint: doctype, head (meta, title, favicon, SEO) and body slot. */
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "coPaint — Free Online Paint & Collaborative Whiteboard",
  description = "Free online paint tool and digital whiteboard. Draw together with MS Paint-like tools, brush styles, shapes, stickers, and realtime classroom collaboration with no login required.",
  keywords = "paint, ms paint, ms paint online, online paint, free online paint, whiteboard, whiteboard online, online whiteboard, digital whiteboard, virtual whiteboard, free whiteboard, collaborative paint, draw together online whiteboard",
  canonical = "https://copaint-qxc.pages.dev/",
  noindex = false
} = Astro.props;

const siteUrl = "https://copaint-qxc.pages.dev";
const fullCanonical = canonical.startsWith("http") ? canonical : `${siteUrl}${canonical}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title}</title>

  <!-- Primary Meta Tags -->
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="coPaint" />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
  <link rel="canonical" href={fullCanonical} />

  <!-- Google Fonts: Baloo 2 (Headings & Brand) + Plus Jakarta Sans (Readable UI & Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="coPaint" />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="coPaint - Free Online Paint and Collaborative Whiteboard" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={fullCanonical} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={`${siteUrl}/og-image.png`} />
  <meta property="twitter:image:alt" content="coPaint - Free Online Paint and Collaborative Whiteboard" />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232b2b3a'/%3E%3Cpath d='M20 45 L43 22' stroke='white' stroke-width='7' stroke-linecap='round'/%3E%3Ccircle cx='47' cy='18' r='5.5' fill='white'/%3E%3C/svg%3E" />

  <!-- JSON-LD Structured Data for WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "coPaint",
    "url": fullCanonical,
    "applicationCategory": "DesignApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Requires HTML5.",
    "description": description,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "MS Paint online free tools",
      "Digital whiteboard and online whiteboard for teaching",
      "Realtime collaborative drawing rooms with no login required",
      "14 drawing tools including pencil, 11 brushes, shapes, bucket fill, highlighter",
      "Autosave, PNG export, and multi-page PDF export"
    ]
  })} />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
