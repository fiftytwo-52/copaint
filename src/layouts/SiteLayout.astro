---
/* Shared page shell for coPaint: doctype, head (meta, title, favicon) and body slot. */
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232b2b3a'/%3E%3Cpath d='M20 45 L43 22' stroke='white' stroke-width='7' stroke-linecap='round'/%3E%3Ccircle cx='47' cy='18' r='5.5' fill='white'/%3E%3C/svg%3E" />
</head>
<body>
  <slot />
</body>
</html>
